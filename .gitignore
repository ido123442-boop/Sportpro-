# Never commit catalog exports, DB dumps or secrets (repo is public)
*.jsonl
*.jsonl.gz
*.sql
*.csv
.env*
.dev.vars
# tracked exceptions (schema and names-only env template)
!migrations/*.sql
!.env.example
dashboard/*.html
audit/dashboard_data.json
audit/live_candidates.json
!worker/schema/*.sql
!staging/seed/*.sql
