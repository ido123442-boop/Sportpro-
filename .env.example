# Names only. Never commit values. Set real values as Cloudflare secrets (wrangler secret put <NAME>)
# or as environment variables in the Claude Code environment settings.

# --- Cloudflare (read-only token for audit: Workers Scripts:Read, D1:Read) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Worker admin API (bearer tokens used by /verify, /orders, /admin) ---
SPORTPRO_STAGING_ADMIN_TOKEN=
SPORTPRO_PROD_ADMIN_TOKEN=

# --- Shopify (the ONE approved writer; least-privilege custom app) ---
SHOPIFY_SHOP_DOMAIN=xayj9j-q9.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=

# --- Safety switches (fail closed if unset) ---
KILL_SWITCH_DEFAULT=ON
SHOPIFY_WRITES_ENABLED=false
